<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.CoolPlayer.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg_splash</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.CoolPlayer.Main</item>
    </style>

    <style name="Theme.CoolPlayer.Main" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/bg_splash</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="Theme.CoolPlayer" parent="Theme.CoolPlayer.Main" />

</resources>